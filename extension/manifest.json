{
  "manifest_version": 3,
  "name": "WolfHunt PRO 2.2 (VK + Telegram 24/7)",
  "version": "2.2.0",
  "description": "Автономная автоохота ВКонтакте и Telegram 24/7 в облаке Render.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WolfHunt PRO 2.1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.vk.com/*",
    "https://*.userapi.com/*",
    "https://wolfhunt-tg.onrender.com/*"
  ]
}